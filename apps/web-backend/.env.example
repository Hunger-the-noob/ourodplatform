# =============================================================================
# 智能助手 / 视频分析配置样例
# 复制为同目录下的 .env 后修改；已存在的环境变量优先（方便命令行临时覆盖）。
# .env 含 API Key，已被 .gitignore 忽略，不要提交。
# =============================================================================

# ---------------------------------------------------------------- 大模型（OpenAI 兼容）
# 任何支持 POST {base_url}/chat/completions 的服务都能用，改这三行即可切换供应商。
LLM_PROVIDER=DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1600

# 其他供应商示例：
#   OpenAI        LLM_PROVIDER=OpenAI      LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   阿里云百炼     LLM_PROVIDER=百炼         LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   智谱 GLM      LLM_PROVIDER=智谱         LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   本地 Ollama   LLM_PROVIDER=Ollama       LLM_BASE_URL=http://127.0.0.1:11434/v1         LLM_MODEL=qwen2.5:7b
#   （Ollama 不校验 Key，LLM_API_KEY 随便填一个非空字符串即可）

# ---------------------------------------------------------------- 本地 YOLO 推理
# 跑推理的 Python 解释器；留空则自动探测（当前进程 → conda 环境注册表 → 常见安装位置）
# ODP_YOLO_PYTHON=D:\Anaconda\envs\credit_risk\python.exe

# 指定权重；留空则按 models/trained → runs/training/*/weights/best.pt → models/pretrained → 自动下载
# ODP_VIDEO_MODEL=C:\Users\NAYOUdUO\ourodplatform\models\trained\20261026-120000-best.pt

# 没有本地权重时自动下载的通用模型（仅在需要时联网一次）
ODP_VIDEO_FALLBACK_MODEL=yolo11n.pt

# CPU 稳定可复现；有 CUDA 可改成 0
ODP_VIDEO_DEVICE=cpu
ODP_VIDEO_CONF=0.25
ODP_VIDEO_IOU=0.7
ODP_VIDEO_IMGSZ=640

# 抽样策略：从整段视频均匀取 N 帧，N 越大越准、越慢
ODP_VIDEO_MAX_FRAMES=24
# 前端允许提交的最大抽样帧数
ODP_VIDEO_MAX_ANALYSIS_FRAMES=60
# 最多保存几张带标注的关键帧
ODP_VIDEO_MAX_KEYFRAMES=6
# 上传大小上限（MB）
ODP_VIDEO_MAX_UPLOAD_MB=200
# 单次推理时间预算（秒），超时后停止抽帧并标注「结果被截断」
ODP_VIDEO_TIME_BUDGET=600
