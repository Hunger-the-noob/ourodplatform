# ============================================================
# ODPlatform 专属(Stage 1 Monorepo 路径)
# ============================================================

# 数据集不进 git(走外部存储或 Git LFS)
data/raw/
data/processed/
!data/README.md
!data/.gitkeep

# 模型权重不进 git
models/pretrained/*.pt
models/trained/*.pt
models/trained/*/
!models/pretrained/README.md
!models/trained/README.md

# 训练运行结果(每次自动产生新目录)
runs/*
!runs/README.md

# 外部数据集压缩包与解压目录(体积大, 不进仓库)
*.zip
PhanLoaiRac.v1i.voc/
waste_dataset/

# Windows 保留设备名, 某些命令会意外生成同名空文件
NUL

# 端私有日志(运行时产生,各机器不同)
apps/platform/logging/
*.log

# 临时文件
tmp/
temp/

# 工具元数据(reset/doctor 等元工具的审计日志,本地运行历史)
.odp-meta/

# ============================================================
# 大文件 / 二进制
# ============================================================
*.pkl
*.h5
*.npz

# 本地密钥与运行配置：只提交模板，不提交真实 Key
.env
.env.*
!.env.example
